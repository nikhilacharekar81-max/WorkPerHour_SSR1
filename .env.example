# ==============================================================================
# WORKPERHOUR: COMMERCIAL ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Server & Hosting
# ------------------------------------------------------------------------------
# Port for the Node.js / Express backend server (default: 3000)
PORT=3000

# Canonical public URL where the application is hosted
APP_URL="https://workperhour.com"

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# High-entropy JWT secret key used for signing user session tokens (min 32 characters in production)
JWT_SECRET="replace-with-a-secure-random-32-character-secret-key"

# One-time bootstrap password for the initial super-admin account (admin@workperhour.com)
ADMIN_INITIAL_PASSWORD="ChangeMeOnFirstLogin123!"

# ------------------------------------------------------------------------------
# Persistence & Database (Optional Relational Tier)
# ------------------------------------------------------------------------------
# PostgreSQL database connection URI (optional; falls back to embedded atomic JSON store)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/workperhour"

# ------------------------------------------------------------------------------
# AI & Intelligence (Google Gemini API)
# ------------------------------------------------------------------------------
# API Key for Google Gemini server-side generative AI features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# Development & Testing Flags
# ------------------------------------------------------------------------------
# Allow simulated wallet deposits in development mode (strictly disabled in production)
ALLOW_SIMULATED_DEPOSITS=false
